#!/bin/sh
# NAS 出厂预接线：给 PigeonBeam（p2pcweb）预置 Box 地址 + 专用 API Key。
#
# 为什么需要（roadmap §3.1 的真实缺口）：
#   今天用户要在 Beam 的「文件柜」tab **手填** Box 地址与 API Key
#   （且要去 Box 管理台手工生成一把 Key 再粘贴）⇒ 装完 NAS 包并不「即用」。
#   ⇒ 本脚本在 NAS 应用启动后自动完成预置 ⇒ **装完即用**。
#
# 三个关键机制（都踩过坑，勿改）：
#   ① API Key **明文只在创建时返回一次**（库里只存 hash/prefix）
#      ⇒ 「缺失才建」**不能靠查列表复用**（列表里没有明文）
#      ⇒ 明文落到本地缓存 ${PB_DATA_PATH}/.beam_box_api_key（0600），
#        每次启动**校验有效性**，失效才重建
#      ⇒ 自愈覆盖：换库 / 用户手动撤销 / 缓存丢失。
#   ② p2pcweb 的 /api/config **只更新非空字段**（留空 = 保持已存值）
#      ⇒ 这里**只发** server_url + box_api_key
#      ⇒ 不动用户已配的 registry（直传注册中心）。
#   ③ 预接线失败**不阻断** Box 启动（优雅降级）
#      ⇒ Beam 退化为「手填」旧行为，应用照常可用。
#
# 环境变量（由各端启动脚本的 prepare_env 注入）：
#   PB_SERVER_PORT（Box 端口，默认 12345）· PB_P2PCWEB_PORT（Beam 端口，默认 12348）
#   PB_DATA_PATH（数据卷）· PB_ADMIN_PASSWORD（向导写入的管理员口令）
#   PB_SHELLKIT_POSIX（POSIX 子集落地路径；不设则按同目录/常见落点探测）
#
# ⚠️ **本文件是 POSIX sh（busybox ash 可执行）**，三端**字节一致**（hub 门禁
#    check-nas-prewire-consistency.sh）。2026-11-19 改造：
#    · 原版是 bash（env-bash shebang + set -uo pipefail + ANSI-C 引号 + 进程替换）
#      ⇒ **busybox ash 上根本跑不起来**：pipefail 非 POSIX（Illegal option -o pipefail）
#      ⇒ openwrt#215 / qnap#204 记的「出厂预接线在真机静默空跑」就是这个根因。
#    · 现在：shebang 走 /bin/sh、去掉 pipefail（保留 set -u）、
#      ANSI-C 引号换成 curl 自己的换行写出行 + 临时文件拆分、
#      进程替换换成 0600 临时配置文件（凭据仍不进 argv —— 见下面那段）。
#    · 装了 shellkit 的 **POSIX 子集**（lib/posix/shellkit-posix.sh，纯 POSIX 语法）：
#      用来做目录创建与退出清理（fs_ensure_dir / trap_push / trap_install）。
#      ⚠️ 子集**缺失不阻断**：本脚本按契约「失败即优雅降级」⇒ 打印提示后退 0
#      （主服务脚本那边是 fail-closed 退 5，两者的差别是有意的）。
#
# 用法: sh prewire_beam_box
set -u

# ── shellkit POSIX 子集（设备侧唯一可用的 shellkit 形态）──────────────────
#   落点探测：① 环境变量 ② 脚本同目录 ③ 同目录 lib/ ④ openwrt /usr/lib ⑤ fnOS cmd/
#   ⚠️ 三端**必须字节一致** ⇒ 不能写死某一端的路径 ⇒ 只能「同目录 + 常见落点」探测。
_sk_dir="$(dirname "$0")"
_sk_lib=""
for _sk_c in \
    "${PB_SHELLKIT_POSIX:-}" \
    "${_sk_dir}/shellkit-posix.sh" \
    "${_sk_dir}/lib/shellkit-posix.sh" \
    "/usr/lib/pigeonbox/shellkit-posix.sh" \
    "/var/apps/pigeonbox/cmd/shellkit-posix.sh"
do
    if [ -n "$_sk_c" ] && [ -r "$_sk_c" ]; then
        _sk_lib="$_sk_c"
        break
    fi
done
if [ -z "$_sk_lib" ]; then
    echo "prewire: 缺 shellkit POSIX 子集（装的是不完整的包）⇒ 跳过（Beam 仍需手填）"
    exit 0
fi
# 路径是运行时探测出来的（脚本同目录 / 各端落点）⇒ shellcheck 追不动，显式声明不追
# shellcheck source=/dev/null
. "$_sk_lib"

SERVER_PORT="${PB_SERVER_PORT:-12345}"
BEAM_PORT="${PB_P2PCWEB_PORT:-12348}"
DATA_DIR="${PB_DATA_PATH:-}"
KEY_NAME="${PB_PREWIRE_KEY_NAME:-p2pcweb-prewire}"
# ⚠️ scope 全量：admin+user+share（用户 2026-11-01 拍板）。
#    p2pcweb 实际只用 X-API-Key 调 /share/file/（投递到柜），
#    但这把 Key 常驻 NAS 数据卷 ⇒ 按用户选择给全量（可随时在管理台撤销）。
SCOPES_JSON='["admin","user","share"]'

if [ -z "$DATA_DIR" ]; then
    echo "prewire: PB_DATA_PATH 未设，跳过（Beam 仍需手填）"
    exit 0
fi

BOX_BASE="http://127.0.0.1:${SERVER_PORT}"
BEAM_BASE="http://127.0.0.1:${BEAM_PORT}"
KEY_CACHE="${DATA_DIR}/.beam_box_api_key"
TOKEN_FILE="${DATA_DIR}/.p2pcweb_token"

# ⚠️ 输出走 **stdout** 且保留「prewire: 」前缀：各端调用方把 stdout 与 stderr
#    一起重定向进服务日志，而仓内自测（scripts/prewire-beam-box-selftest.sh）
#    判据 ⑥ 直接断言 stdout 里的文案 ⇒ 改流/改文案都会让自测失配。
#    ⇒ 这里**不用** shellkit 的 log_*（那套一律走 stderr）。
log() { echo "prewire: $*"; }

# ── 0. 依赖检查 ────────────────────────────────────────────────────────
if [ -z "${PB_ADMIN_PASSWORD:-}" ]; then
    log "未设 PB_ADMIN_PASSWORD（未走向导建号）⇒ 跳过（Beam 仍需手填）"
    exit 0
fi

# 临时目录（curl 配置与登录响应落这里）⇒ 退出时清掉（POSIX 子集的 trap 栈）。
# ⚠️ 落在数据卷下而不是 /tmp：/tmp 在 NAS 上可能被别的应用清、且跨用户不可写。
WORK_DIR="${DATA_DIR}/.prewire.$$"
if ! fs_ensure_dir "$WORK_DIR" 700; then
    log "临时目录建不出来（${WORK_DIR}）⇒ 跳过（Beam 仍需手填）"
    exit 0
fi
# 单引号是**故意的**：trap_push 存的是待执行的命令串，退出时才 eval
# ⇒ 里面的 ${WORK_DIR} 要到那时才展开（写成双引号就变成「现在就展开」了）
# shellcheck disable=SC2016
trap_push 'rm -rf "${WORK_DIR}"'
trap_install

# ── 1. 等 Box 与 p2pcweb 就绪（**等待逻辑放在脚本里**，不放在各端包装函数）──
#   ⚠️ 为什么必须自包含：openwrt 的 Box 与 p2pcweb 由 procd **异步**拉起
#   ⇒ 调用预接线的时刻可能**早于**两者就绪
#   ⇒ 若只在包装函数里等一次 ⇒ 会**偶发**跳过 ⇒ 表现为「装完还是得手填」
#   ⇒ 且偶发 ⇒ 极难复现、极难归因。
#   ⇒ 这里同时等两件事：Box /ping 就绪 **且** p2pcweb 令牌文件出现。
WAIT_MAX="${PB_PREWIRE_WAIT_MAX:-30}"
waited=0
ready=0
while [ "$waited" -lt "$WAIT_MAX" ]; do
    if curl -s -m 2 "${BOX_BASE}/ping" 2>/dev/null | grep -q pong \
        && [ -s "${TOKEN_FILE}" ]; then
        ready=1
        break
    fi
    sleep 1
    waited=$((waited + 1))
done
if [ "$ready" != "1" ]; then
    log "Box 或 p2pcweb 未就绪（等 ${WAIT_MAX}s）⇒ 跳过（Beam 仍需手填）"
    exit 0
fi

# ── 凭据一律不进 argv（fnos#210 / qnap#190 / openwrt#201）────────────────
#   Linux /proc/<pid>/cmdline 是 0444 **世界可读** ⇒ admin 口令/会话 Token/API Key
#   一旦出现在 curl 的 -H/-d 参数里，本地任意进程都能在 curl 窗口（-m8）里读到。
#   ⇒ body 走 stdin 管道：printf ... | curl ... --data-binary @-
#   ⇒ 头走 curl 配置文件：curl -K <file>（-K/--config）。
#   ⚠️ **原版用进程替换 <(...) 分流头与 body**（bash 专有 ⇒ ash 上直接报错），
#      现在改成把 curl 配置写进 **0600 临时文件**（凭据在文件里、不在 argv；
#      文件路径在 argv、内容不在 ⇒ 与原版的凭据暴露面等价），退出时随临时目录清掉。
#   兼容依据：-K/--config 与「--data @file / @-」都是 curl 4.x（1998 年前后）
#   就有的老特性，OpenWrt/QTS/fnOS 发行的 curl 7.x 全线支持；刻意**不用**较新的
#   -H @file（curl ≥7.55 才有）。
#   ⚠️ 三端本脚本必须**字节一致**（hub 门禁 check-nas-prewire-consistency.sh）。

# ── 2. 复用缓存的 Key（校验有效性）────────────────────────────────────
#    ⚠️ 校验必须**打到真正会被读到的量**上：用 API Key 头访问受鉴权端点，
#    200 = 有效；401/403 = 已失效 ⇒ 走重建。
cached_key=""
if [ -r "$KEY_CACHE" ]; then
    cached_key="$(head -n 1 "$KEY_CACHE" 2>/dev/null | tr -d '[:space:]')"
fi
if [ -n "$cached_key" ]; then
    # ⚠️ 校验端点必须是**接受 API Key 且只读**的那个：
    #   /user/api-keys 是**会话面**（AuthMiddleware）⇒ 用 API Key 调恒 401
    #   ⇒ 会把「好 Key」误判成「已失效」⇒ 每次启动都重建一把（Key 列表膨胀）。
    #   /api/v1/user/shares 走 UserOrAPIKey ⇒ 只读、无副作用、认 X-API-Key。
    # Key 是凭据 ⇒ 头走配置文件（-K），不进 argv。
    code=$(printf 'header = "X-API-Key: %s"\n' "$cached_key" \
        >"${WORK_DIR}/key.cfg" && \
        curl -s -o /dev/null -w '%{http_code}' -m 5 -K "${WORK_DIR}/key.cfg" \
        "${BOX_BASE}/api/v1/user/shares" 2>/dev/null)
    case "$code" in
        200)
            log "复用缓存的 API Key（校验 ${code}）"
            ;;
        *)
            log "缓存的 API Key 已失效（${code}）⇒ 重建"
            cached_key=""
            ;;
    esac
fi

# ── 3. 没有可用 Key ⇒ 登录 + 建一把 ───────────────────────────────────
if [ -z "$cached_key" ]; then
    # 3a. 登录拿会话 token（口令**不打印**）—— 一并抓 HTTP 码，
    #     区分「.env 口令已过期」与网络/服务端其它失败（401=凭据被拒）。
    # 口令是凭据 ⇒ body 走 stdin 管道（printf | curl --data-binary @-），不进 argv。
    # ⚠️ 响应与状态码用**临时文件**拆（bash 的 ANSI-C 引号拆法在 ash 上不可用）：
    #   curl 的 -w 认换行（写出行格式）⇒ 响应体在倒数第二行、状态码在最后一行。
    printf '{"username":"admin","password":"%s"}' "${PB_ADMIN_PASSWORD}" \
        | curl -sS -m 8 -X POST "${BOX_BASE}/admin/login" \
        -H 'Content-Type: application/json' --data-binary @- \
        -w '\n%{http_code}' >"${WORK_DIR}/login.out" 2>/dev/null
    login_code="$(tail -n 1 "${WORK_DIR}/login.out" 2>/dev/null)"
    login_resp="$(sed '$d' "${WORK_DIR}/login.out" 2>/dev/null)"
    token=$(printf '%s' "$login_resp" \
        | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ -z "$token" ]; then
        case "$login_code" in
            401)
                log "登录失败（HTTP 401）⇒ .env 口令已过期（PB_ADMIN_PASSWORD 与库中口令不符）⇒ 跳过（Beam 仍需手填）"
                ;;
            429)
                log "登录失败（HTTP 429，失败锁定中）⇒ 跳过（Beam 仍需手填）"
                ;;
            *)
                log "登录失败（HTTP ${login_code:-000}）⇒ 跳过（Beam 仍需手填）"
                ;;
        esac
        exit 0
    fi
    # 3b. 创建专用 Key（全量 scope，名字固定 ⇒ 用户在管理台一眼认得、可撤销）
    create_body=$(printf '{"name":"%s","scopes":%s}' "$KEY_NAME" "$SCOPES_JSON")
    # 会话 Token 是凭据 ⇒ 头走配置文件（-K）；create_body 只含 Key 名字与
    # scope（非敏感）⇒ 留 argv，不与 stdin 抢占。
    printf 'header = "Authorization: Bearer %s"\n' "$token" >"${WORK_DIR}/auth.cfg"
    create_resp=$(printf '%s' "$create_body" \
        | curl -sS -m 8 -X POST "${BOX_BASE}/user/api-keys" \
        -K "${WORK_DIR}/auth.cfg" -H 'Content-Type: application/json' \
        --data-binary "$create_body" 2>/dev/null)
    cached_key=$(printf '%s' "$create_resp" \
        | sed -n 's/.*"key"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ -z "$cached_key" ]; then
        log "创建 API Key 失败 ⇒ 跳过（Beam 仍需手填）"
        exit 0
    fi
    # 3c. 明文落缓存（0600）—— 只此一次机会，丢了就只能重建
    (umask 077 && printf '%s' "$cached_key" > "$KEY_CACHE") || {
        log "缓存文件写入失败 ⇒ 跳过（Beam 仍需手填）"
        exit 0
    }
    log "已创建 API Key（${KEY_NAME}）并缓存到数据卷"
fi

# ── 4. 写入 p2pcweb 配置（只发非空字段 ⇒ 不动已配的 registry）────────
beam_token=$(head -n 1 "$TOKEN_FILE" 2>/dev/null | tr -d '[:space:]')
if [ -z "$beam_token" ]; then
    log "p2pcweb 令牌为空 ⇒ 跳过"
    exit 0
fi
config_body=$(printf '{"server_url":"%s","box_api_key":"%s"}' "$BOX_BASE" "$cached_key")
# ⚠️ p2pcweb 的 guard：令牌走 **X-P2PCWEB 头**；
#   只有首页 `/` 才认 `?t=`（query）⇒ 用 `?t=` 调 API 恒 403「令牌无效」（真机实录）。
# 这一发头（p2pcweb 会话 Token）与 body（全量 scope API Key）**都敏感** ⇒
# 头走 0600 临时配置文件、body 走 stdin 管道（一次 curl 只有一个 stdin，
# -K 与 @- 不能同用）。
printf 'header = "X-P2PCWEB: %s"\n' "$beam_token" >"${WORK_DIR}/beam.cfg"
config_resp=$(printf '%s' "$config_body" \
    | curl -sS -m 8 -X POST "${BEAM_BASE}/api/config" \
    -K "${WORK_DIR}/beam.cfg" \
    -H 'Content-Type: application/json' \
    --data-binary @- 2>/dev/null)
case "$config_resp" in
    *'"ok"'*)
        log "已预置 Beam 文件柜（地址 ${BOX_BASE} + 专用 API Key）"
        exit 0
        ;;
    *)
        log "写 p2pcweb 配置失败：$(printf '%s' "$config_resp" | head -c 200)"
        exit 0
        ;;
esac
